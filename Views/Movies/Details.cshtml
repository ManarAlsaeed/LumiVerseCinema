@model MiniCinema.Models.Movie

@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5">
    <div class="container">
        <a asp-action="Index" class="btn btn-outline-light mb-4">
            ← Back to Movies
        </a>

        <div class="row g-4">
            <div class="col-md-4">
                <img src="@Model.PosterUrl"
                     class="img-fluid rounded shadow"
                     style="max-height:550px; object-fit:cover;" />
            </div>

            <div class="col-md-8">
                <h1 class="text-warning fw-bold">@Model.Title</h1>

                <p class="lead">@Model.Description</p>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Genre:</strong> @Model.Genre
                    </li>
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Director:</strong> @Model.Director
                    </li>
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Cast:</strong> @Model.Cast
                    </li>
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Duration:</strong> @Model.DurationMinutes minutes
                    </li>
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Rating:</strong> @Model.Rating / 10
                    </li>
                    <li class="list-group-item bg-dark text-light border-secondary">
                        <strong>Release Date:</strong> @Model.ReleaseDate.ToShortDateString()
                    </li>
                </ul>

                <h3 class="text-warning">Available Showtimes</h3>

                @if (Model.Showtimes == null || !Model.Showtimes.Any())
                {
                    <div class="alert alert-warning">
                        No showtimes available.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var showtime in Model.Showtimes.OrderBy(s => s.ShowDateTime))
                        {
                            <div class="col-md-6">
                                <div class="card bg-black border-secondary text-light">
                                    <div class="card-body">
                                        <h5 class="text-warning">
                                            @showtime.ShowDateTime.ToString("MMM dd, yyyy - HH:mm")
                                        </h5>

                                        <p class="mb-1">Hall: @showtime.Hall</p>
                                        <p class="mb-1">Available Seats: @showtime.AvailableSeats</p>
                                        <p class="mb-3">Ticket Price: $@showtime.TicketPrice</p>

                                        @if (showtime.AvailableSeats > 0)
                                        {
                                            <a asp-controller="Booking"
                                               asp-action="Index"
                                               asp-route-id="@showtime.Id"
                                               class="btn btn-warning w-100">
                                                Book Ticket
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary w-100" disabled>
                                                Sold Out
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>