<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini Cinema</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-warning">
    <div class="container">
        <a class="navbar-brand text-warning fw-bold" asp-controller="Home" asp-action="Index">
            🎬 MiniCinema
        </a>

        <div class="navbar-nav ms-auto">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link" asp-controller="Movies" asp-action="Index">Movies</a>

            @if (Context.Session.GetInt32("UserId") != null)
            {
                <a class="nav-link" asp-controller="Booking" asp-action="MyBookings">My Bookings</a>

                @if (Context.Session.GetString("IsAdmin") == "True")
                {
                    <a class="nav-link text-warning" asp-controller="Admin" asp-action="Dashboard">Admin</a>
                }

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-light ms-2" type="submit">Logout</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-sm btn-warning ms-2" asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </div>
</nav>

<main>
    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger">@TempData["Error"]</div>
        </div>
    }

    @RenderBody()
</main>

<footer class="text-center py-4 bg-black mt-5 border-top border-secondary">
    <p class="mb-0 text-muted">© @DateTime.Now.Year MiniCinema Booking System</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>