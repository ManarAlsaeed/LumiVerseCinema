<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - MCinema</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-dark text-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-warning">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
    <img src="~/images/mcinema-logo.png"
         alt="MCinema Logo"
         class="site-logo" />
    <span class="brand-name">MCinema</span>
</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <div class="navbar-nav ms-auto align-items-lg-center">

                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>

                <a class="nav-link" asp-controller="Movies" asp-action="Index">Movies</a>

                <a class="nav-link" asp-controller="Halls" asp-action="Index">Halls</a>

                <a class="nav-link" asp-controller="Food" asp-action="Index">🍿 Food</a>

                <a class="nav-link" asp-controller="Offers" asp-action="Index">🎫 Offers</a>

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a class="nav-link" asp-controller="Booking" asp-action="MyBookings">My Bookings</a>

                    @if (Context.Session.GetString("IsAdmin") == "True")
                    {
                        <div class="nav-item dropdown ms-lg-2">
                            <a class="btn btn-sm btn-warning dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Admin
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Movies">Movies</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Food">🍿 Food</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Offers">🎫 Offers</a>
                                </li>
                            </ul>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-lg-2">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-light" type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-sm btn-warning ms-lg-2" asp-controller="Account" asp-action="Register">Register</a>
                }

            </div>
        </div>
    </div>
</nav>

<main>
    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger">@TempData["Error"]</div>
        </div>
    }

    @RenderBody()
</main>

<footer class="text-center py-4 bg-black mt-5 border-top border-secondary">
<p class="mb-0 text-muted">© @DateTime.Now.Year MCinema Booking System</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>