@model List<MiniCinema.Models.FoodItem>
@{
    ViewData["Title"] = "Manage Food";
}
 
<section class="py-5 bg-dark min-vh-100">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-white fw-bold">
                <i class="bi bi-cup-straw text-warning me-2"></i> Manage Food & Drinks
            </h1>
            <div class="d-flex gap-2">
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
                <a asp-action="AddEditFood" class="btn btn-warning btn-sm">+ Add Item</a>
            </div>
        </div>
 
        <div class="bg-black rounded-3 border border-secondary p-4">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Image</th><th>Name</th><th>Category</th>
                            <th>Price</th><th>Best Seller</th><th>Status</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" style="width:45px;height:45px;object-fit:cover;border-radius:6px;" />
                                </td>
                                <td class="text-white align-middle">@item.Name</td>
                                <td class="text-muted align-middle"><small>@item.Category</small></td>
                                <td class="text-warning align-middle">$@item.Price.ToString("F2")</td>
                                <td class="align-middle">
                                    @if (item.IsBestSeller)
                                    {
                                        <span class="badge bg-warning text-dark">⭐ Yes</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary")">
                                        @(item.IsAvailable ? "Available" : "Hidden")
                                    </span>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex gap-1">
                                        <a asp-action="AddEditFood" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="DeleteFood" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove this item?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>