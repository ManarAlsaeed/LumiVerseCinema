@model MiniCinema.Models.FoodItem
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Food Item" : "Edit Food Item";
    bool isEdit = Model.Id != 0;
}
 
<section class="py-5 bg-dark min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-white fw-bold">
                        <i class="bi bi-cup-hot text-warning me-2"></i>
                        @(isEdit ? "Edit Food Item" : "Add Food Item")
                    </h2>
                    <a asp-action="Food" class="btn btn-outline-secondary btn-sm">← Back</a>
                </div>
 
                <div class="bg-black rounded-3 border border-secondary p-4">
                    <form asp-action="AddEditFood" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
 
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label text-muted small">Name *</label>
                                <input asp-for="Name" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Category *</label>
                                <select asp-for="Category" class="form-select bg-dark text-white border-secondary"
                                        asp-items="Html.GetEnumSelectList<MiniCinema.Models.FoodCategory>()">
                                </select>
                            </div>
 
                            <div class="col-12">
                                <label class="form-label text-muted small">Description</label>
                                <input asp-for="Description" class="form-control bg-dark text-white border-secondary" />
                            </div>
 
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Price ($) *</label>
                                <input asp-for="Price" type="number" step="0.50" min="0"
                                       class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label text-muted small">Image URL</label>
                                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary"
                                       placeholder="https://..." id="foodImgUrl" />
                            </div>
 
                            <div class="col-auto">
                                <img id="foodPreview" src="@(isEdit ? Model.ImageUrl : "")"
                                     alt="preview" style="height:70px;border-radius:6px;display:@(isEdit ? "block" : "none")" />
                            </div>
 
                            <div class="col-12 d-flex gap-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsAvailable" class="form-check-label text-muted">Available</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="IsBestSeller" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsBestSeller" class="form-check-label text-muted">Best Seller ⭐</label>
                                </div>
                            </div>
                        </div>
 
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-warning px-5 fw-semibold">
                                <i class="bi bi-check-circle me-2"></i> @(isEdit ? "Save Changes" : "Add Item")
                            </button>
                            <a asp-action="Food" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
 
@section Scripts {
<script>
document.getElementById('foodImgUrl')?.addEventListener('input', function() {
    const preview = document.getElementById('foodPreview');
    preview.src = this.value;
    preview.style.display = 'block';
});
</script>
}