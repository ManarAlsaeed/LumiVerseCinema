@model List<MiniCinema.Models.Booking>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="py-5">
    <div class="container">
        <h1 class="text-warning mb-4">Admin Dashboard</h1>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card bg-black text-light border-secondary">
                    <div class="card-body text-center">
                        <h5>Total Movies</h5>
                        <h2 class="text-warning">@ViewBag.TotalMovies</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-black text-light border-secondary">
                    <div class="card-body text-center">
                        <h5>Total Bookings</h5>
                        <h2 class="text-warning">@ViewBag.TotalBookings</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-black text-light border-secondary">
                    <div class="card-body text-center">
                        <h5>Total Users</h5>
                        <h2 class="text-warning">@ViewBag.TotalUsers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-black text-light border-secondary">
                    <div class="card-body text-center">
                        <h5>Total Revenue</h5>
                        <h2 class="text-warning">$@ViewBag.TotalRevenue</h2>
                    </div>
                </div>
            </div>
        </div>

        <a asp-action="Movies" class="btn btn-warning mb-4">
            Manage Movies
        </a>

        <h3 class="text-warning mb-3">Recent Bookings</h3>

        @if (!Model.Any())
        {
            <div class="alert alert-warning">
                No bookings yet.
            </div>
        }
        else
        {
            <table class="table table-dark table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>User</th>
                        <th>Movie</th>
                        <th>Tickets</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.BookingReference</td>
                            <td>@booking.User?.FullName</td>
                            <td>@booking.Showtime?.Movie?.Title</td>
                            <td>@booking.NumberOfTickets</td>
                            <td>$@booking.TotalAmount</td>
                            <td>@booking.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>